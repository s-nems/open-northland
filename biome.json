{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/app/src/**",
        "!packages/app/src/entries/**",
        "!packages/app/src/scenes/**",
        "!packages/app/src/game/sandbox/**",
        "!packages/app/src/game/world/**",
        "!packages/app/src/session/inline-host.ts",
        "!packages/app/src/session/worker/serve.ts",
        "!packages/app/src/session/worker/net-world-port.ts",
        "!packages/app/src/session/worker/facts.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@open-northland/sim": {
                    "importNames": ["Simulation"],
                    "message": "The runtime reads the world through SessionHost (packages/app/src/session/); only hosts hold a Simulation."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}

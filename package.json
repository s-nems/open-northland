{
  "name": "open-northland",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source cross-platform rebuild of Cultures - 8th Wonder of the World",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://opennorthland.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-nems/open-northland.git"
  },
  "bugs": "https://github.com/s-nems/open-northland/issues",
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build --workspace @open-northland/app",
    "clean": "tsc --build --clean",
    "typecheck": "npm run typecheck:test",
    "typecheck:test": "tsc --build && tsc --project tsconfig.tests.json",
    "test": "npm run test:scripts && npm run typecheck && vitest run --project=!content",
    "test:scripts": "node --test scripts/test/*.test.mjs",
    "test:watch": "vitest --project=!content",
    "bench:sim": "node scripts/bench-sim.mjs",
    "bench:map": "node scripts/bench-map.mjs",
    "bench:profile": "node scripts/bench-profile.mjs",
    "bench:compare": "node scripts/bench-compare.mjs",
    "test:content": "node scripts/test-content.mjs",
    "test:pipeline": "node scripts/test-pipeline.mjs",
    "test:engines": "node scripts/test-engines.mjs",
    "relay": "tsc --build && node packages/net-server/dist/main.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:assets": "node scripts/check-repository-assets.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "missions:coverage": "tsc --build && node scripts/mission-coverage.mjs",
    "tickets:list": "node scripts/list-tickets.mjs",
    "desktop": "npm run build && npm run start --workspace @open-northland/desktop",
    "desktop:dist": "npm run build && npm run dist --workspace @open-northland/desktop",
    "relay:image": "docker buildx build --file packages/net-server/Dockerfile --tag open-northland-relay --load .",
    "web:image": "docker buildx build --file deploy/web/Dockerfile --build-context app=packages/app/dist --build-context content=content --tag open-northland-web --load deploy/web",
    "dev": "npm run dev --workspace @open-northland/app --",
    "dev:ports": "scripts/dev-ports.sh",
    "dev:verify": "npm run dev:verify --workspace @open-northland/app --",
    "dev:reset": "scripts/dev-reset.sh",
    "shot": "npm run shot --workspace @open-northland/app --",
    "pipeline": "npm run start --workspace @open-northland/asset-pipeline --",
    "build:content": "node scripts/build-content.mjs",
    "test:desktop": "npm run build && npm run test:e2e --workspace @open-northland/desktop"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "electron@43.7.3": true
  }
}

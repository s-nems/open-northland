{
  "name": "open-northland",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source cross-platform rebuild of Cultures - 8th Wonder of the World",
  "license": "AGPL-3.0-or-later AND GPL-3.0-only",
  "homepage": "https://opennorthland.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-nems/open-northland.git"
  },
  "bugs": "https://github.com/s-nems/open-northland/issues",
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "node scripts/build-content.mjs --if-stale && npm run typecheck && npm run build --workspace @open-northland/app",
    "clean": "tsc --build --clean",
    "typecheck": "npm run typecheck:test",
    "typecheck:test": "tsc --build && tsc --project tsconfig.tests.json",
    "test": "node scripts/run-gated.mjs npm run test:steps --",
    "test:steps": "npm run test:scripts && npm run typecheck && npm run test:vitest --",
    "test:vitest": "node scripts/run-gated.mjs vitest run --project=app --project=core",
    "test:slow": "node scripts/run-gated.mjs vitest run --project=app-slow --project=core-slow",
    "test:scripts": "node --test scripts/test/*.test.mjs",
    "test:watch": "vitest --project=app --project=core",
    "bench:sim": "node scripts/bench-sim.mjs",
    "bench:map": "node scripts/bench-map.mjs",
    "bench:profile": "node scripts/bench-profile.mjs",
    "bench:parity": "node scripts/bench-parity.mjs",
    "bench:compare": "node scripts/bench-compare.mjs",
    "bench:browser": "node scripts/bench-browser.mjs",
    "bench:browser-shots": "node scripts/bench-browser-shots.mjs",
    "bench:gpu": "node scripts/bench-gpu.mjs",
    "bench:hud": "node scripts/bench-hud.mjs",
    "test:content": "node scripts/run-gated.mjs node scripts/test-content.mjs",
    "test:pipeline": "node scripts/test-pipeline.mjs",
    "test:engines": "node scripts/test-engines.mjs",
    "test:boot": "node scripts/test-boot.mjs",
    "test:shaders": "node scripts/test-shaders.mjs",
    "relay": "tsc --build && node packages/net-server/dist/main.js",
    "api": "tsc --build && node packages/api/dist/main.js",
    "api:upstream-mock": "tsc --build && node packages/api/dist/upstream-mock/main.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:assets": "node scripts/check-repository-assets.mjs",
    "check:translations": "npm run check:translations --workspace @open-northland/translation-tools",
    "brand": "npm run generate --workspace @open-northland/brand",
    "check:docs": "node scripts/check-docs.mjs",
    "diag": "node scripts/diag-bundle.mjs",
    "missions:coverage": "tsc --build && node scripts/mission-coverage.mjs",
    "mission:script": "node scripts/mission-script.mjs",
    "map:convert": "node scripts/convert-map.mjs",
    "tickets:list": "node scripts/list-tickets.mjs",
    "desktop": "npm run build && npm run start --workspace @open-northland/desktop",
    "desktop:dist": "npm run build && npm run dist --workspace @open-northland/desktop",
    "api:image": "docker buildx build --file packages/api/Dockerfile --tag open-northland-api --load .",
    "relay:image": "docker buildx build --file packages/net-server/Dockerfile --tag open-northland-relay --load .",
    "web:image": "docker buildx build --file deploy/web/Dockerfile --build-context app=packages/app/dist --build-context content=content --tag open-northland-web --load deploy/web",
    "dev": "node scripts/build-content.mjs --if-stale && npm run dev --workspace @open-northland/app --",
    "dev:ports": "scripts/dev-ports.sh",
    "dev:verify": "npm run dev:verify --workspace @open-northland/app --",
    "dev:reset": "scripts/dev-reset.sh",
    "shot": "npm run shot --workspace @open-northland/app --",
    "pipeline": "npm run start --workspace @open-northland/asset-pipeline --",
    "import:cultures-localization": "npm run import:cultures-localization --workspace @open-northland/translation-tools --",
    "translations:skeleton": "npm run translations:skeleton --workspace @open-northland/translation-tools --",
    "translations:derive-cht": "npm run translations:derive-cht --workspace @open-northland/translation-tools --",
    "build:content": "node scripts/build-content.mjs",
    "test:desktop": "npm run build && npm run test:e2e --workspace @open-northland/desktop",
    "test:gate": "npm run test:e2e --workspace @open-northland/app"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "electron@44.5.1": true
  }
}

+// --- DX8 pattern/sequence track scheduling ---------------------------------------------------
+
+// Default performance chord (root C in the top byte) used when a segment carries no chord track;
+// matches the default subchord MusicValueToMIDI falls back to.
+static const std::uint32_t DEFAULT_CHORD = 12u << 24;
+
+// Percussion channel folding, as in playPattern.
+static std::uint32_t foldPercussionChannel(std::uint32_t pChannel) {
+    if (pChannel >= 9 && (pChannel - 9) % 16 == 0) return 9;
+    return pChannel;
+}
+
+// Sequential variation choice: repeat r plays the r-th authored variation, wrapping around.
+static std::uint8_t pickSequentialVariation(const DMUS_IO_STYLEPART& partHeader, std::uint32_t repeat) {
+    std::uint8_t available[32];
+    std::uint8_t count = 0;
+    for (std::uint8_t i = 0; i < 32; i++) {
+        if (partHeader.dwVariationChoices[i] & 0x0FFFFFFF) {
+            available[count++] = i;
+        }
+    }
+    if (count == 0) return 0;
+    return available[repeat % count];
+}
+
+void DirectMusic::scheduleDx8PatternTrack(const PatternTrack& track, std::uint32_t segmentLength,
+    std::vector<std::shared_ptr<MusicMessage>>& messages) {
+    const auto& form = track.getPattern();
+    if (form == nullptr) return;
+
+    std::map<GUID, StylePart> parts;
+    for (const auto& part : form->getParts()) {
+        parts[part.getHeader().guidPartID] = part;
+    }
+
+    const auto& patternHeader = form->getHeader();
+    std::uint32_t patternLength = patternHeader.wNbrMeasures * getMeasureLength(patternHeader.timeSig);
+    if (patternLength == 0) return;
+
+    const std::vector<DMUS_IO_SUBCHORD> noSubchords;
+
+    for (const auto& partRefTuple : form->getPartReferences()) {
+        const auto& partRef = partRefTuple.first;
+        auto found = parts.find(partRef.guidPartID);
+        if (found == parts.end()) {
+            throw std::runtime_error("Couldn't find part: " + partRef.guidPartID.toString());
+        }
+        const StylePart& part = found->second;
+        const auto& partHeader = part.getHeader();
+        std::uint32_t pChannel = foldPercussionChannel(partRef.wLogicalPartID);
+
+        std::uint32_t repeat = 0;
+        for (std::uint32_t start = 0; start < segmentLength; start += patternLength, repeat++) {
+            std::uint32_t variation = 1u << pickSequentialVariation(partHeader, repeat);
+
+            for (const auto& note : part.getNotes()) {
+                if (!(note.dwVariation & variation)) continue;
+
+                std::int64_t time = (std::int64_t)start
+                    + getMusicOffset(note.mtGridStart, note.nTimeOffset, partHeader.timeSig);
+                if (time < 0 || time >= (std::int64_t)segmentLength) continue;
+
+                std::uint8_t midiNote;
+                if (MusicValueToMIDI(DEFAULT_CHORD, noSubchords, note, partHeader, &midiNote)) {
+                    messages.push_back(std::make_shared<NoteOnMessage>((std::uint32_t)time,
+                        midiNote, note.bVelocity, 0, partRef.wLogicalPartID, pChannel));
+                    messages.push_back(std::make_shared<NoteOffMessage>((std::uint32_t)(time + note.mtDuration),
+                        midiNote, partRef.wLogicalPartID, pChannel));
+                }
+            }
+
+            for (const auto& curve : part.getCurves()) {
+                if (!(curve.dwVariation & variation)) continue;
+                if (curve.bEventType != DMUS_CURVET_CCCURVE) continue;
+                if (curve.nStartValue > 127 || curve.nEndValue > 127) continue;
+
+                std::int64_t timeStart = (std::int64_t)start
+                    + getMusicOffset(curve.mtGridStart, curve.nTimeOffset, partHeader.timeSig);
+                std::uint32_t duration = curve.mtDuration;
+                float startValue = (float)curve.nStartValue / 127, endValue = (float)curve.nEndValue / 127;
+                auto control = (DirectMusic::Midi::Control)curve.bCCData;
+
+                for (std::uint32_t i = 0; i < duration / DMUSIC_CURVE_MESSAGE_SPACING; i++) {
+                    std::uint32_t offset = i * DMUSIC_CURVE_MESSAGE_SPACING;
+                    float phase = (float)offset / duration;
+                    std::int64_t time = timeStart + offset;
+                    if (time < 0 || time >= (std::int64_t)segmentLength) continue;
+
+                    float value;
+                    switch (curve.bCurveShape) {
+                    case DMUS_CURVES_INSTANT: value = endValue; break;
+                    case DMUS_CURVES_EXP: value = lerp(phase * phase * phase * phase, startValue, endValue); break;
+                    case DMUS_CURVES_LOG: value = lerp(sqrtf(phase), startValue, endValue); break;
+                    case DMUS_CURVES_SINE: value = lerp((sinf((phase - 0.5f) * PI) + 1) * 0.5f, startValue, endValue); break;
+                    case DMUS_CURVES_LINEAR:
+                    default: value = lerp(phase, startValue, endValue); break;
+                    }
+
+                    messages.push_back(std::make_shared<ControlChangeMessage>((std::uint32_t)time,
+                        partRef.wLogicalPartID, pChannel, control, value));
+                }
+            }
+        }
+    }
+}
+
+void DirectMusic::scheduleSequenceTrack(const SequenceTrack& track,
+    std::vector<std::shared_ptr<MusicMessage>>& messages) {
+    static const std::uint8_t MIDI_NOTE_ON = 0x90;
+
+    for (const auto& item : track.getSequenceItems()) {
+        if ((item.bStatus & 0xF0) != MIDI_NOTE_ON) continue;
+
+        std::int64_t time = (std::int64_t)item.mtTime + item.nOffset;
+        if (time < 0) time = 0;
+        std::uint32_t pChannel = foldPercussionChannel(item.dwPChannel);
+
+        messages.push_back(std::make_shared<NoteOnMessage>((std::uint32_t)time,
+            item.bByte1, item.bByte2, 0, item.dwPChannel, pChannel));
+        messages.push_back(std::make_shared<NoteOffMessage>((std::uint32_t)(time + item.mtDuration),
+            item.bByte1, item.dwPChannel, pChannel));
+    }
+}

# Dependencies
node_modules/

# Build output
dist/
dist-types/
# packages/app's tsc output, kept apart from the Vite build in dist/ that ships
dist-tsc/
*.tsbuildinfo
# electron-builder output
packages/desktop/release/
# koffi binaries staged for the platform being packaged
packages/desktop/dist-native/

# Generated intermediate content - DERIVED FROM COPYRIGHTED GAME DATA.
# Never commit.
# Anchored to the repo root (leading slash) so it ONLY ignores the top-level game-asset output,
# NOT source directories that happen to be named `content` (e.g. packages/app/src/content/).
/content/
!/content/.gitkeep

# Never commit original game assets / binaries, even if copied in by accident.
*.bmd
*.cif
*.hlt
*.pcx
*.lib
*.sgt
*.dls
*.fnt
*.wav
*.cur
map.dat
*.exe
*.dll

# Local configuration and credentials
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# OS / editor / local agent tooling
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Local agent tooling
/.claude/
/.codex/
/.mcp.json

# Browser-automation artifacts (acceptance-scene verification, screenshots, console dumps).
# Root-anchored on purpose: committed documentation images live under docs/images/ and stay tracked.
.playwright-mcp/
/*.png
# `npm run shot` writes its verification PNG beside the app package (--out defaults to cwd).
/packages/app/shot.png

# The API server's default data dir: the synced catalogue, raw upstream pages and thumbnails.
/.api-data/
# The API server's default bug report dir: players' reports, never committed.
/.api-reports/
/.api-upstream-cache/

# Benchmark reports. Absolute timings only mean something against another run on the same machine,
# so a baseline belongs to a checkout, never to the repository.
/bench-out/

# Temporary image generation output
/output/imagegen/


# Logs
*.log
npm-debug.log*

# Art build candidates and publication transactions
/.art-build/
**/__pycache__/
*.blend1

# Source data cache and transactional content builds
/.cache/

# Per-map mission playtest probes agents write for one session (docs/TESTING.md "Mission playtests").
/packages/app/test/real-content/playtest/local/

# Hidden source maps of the last app build (packages/app/build/source-maps.ts); never shipped.
/packages/app/dist-sourcemaps/

{
  "name": "@open-northland/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "OpenNorthland desktop shell - a game window serving the built web app and the converted content over app://",
  "license": "AGPL-3.0-or-later",
  "author": "OpenNorthland contributors",
  "main": "./dist/main.cjs",
  "scripts": {
    "build": "tsc --build && node scripts/bundle.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:win": "npm run build && electron-builder --config electron-builder.yml --win",
    "test:e2e": "node scripts/bundle.mjs && vitest run --config vitest.e2e.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.16.1",
    "esbuild": "^0.28.2"
  }
}
